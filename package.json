{
  "name": "vigooth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vigooth/portal dev",
    "dev:all": "pnpm --filter './apps/*' --parallel dev",
    "dev:portal": "pnpm --filter @vigooth/portal dev",
    "dev:vilock": "pnpm --filter @vigooth/vilock dev",
    "dev:moovi": "pnpm --filter @vigooth/moovi dev",
    "dev:steam": "pnpm --filter @vigooth/steam dev",
    "dev:api": "cd services/api && set -a && [ -f .env ] && . .env && set +a && PORT=8090 go run ./cmd/server",
    "build": "pnpm -r build",
    "build:portal": "pnpm --filter @vigooth/portal build",
    "build:vilock": "pnpm --filter @vigooth/vilock build",
    "build:moovi": "pnpm --filter @vigooth/moovi build",
    "build:steam": "pnpm --filter @vigooth/steam build",
    "lint": "oxlint",
    "format": "oxfmt .",
    "type-check": "pnpm -r type-check",
    "prepare": "husky install",
    "tui": "pnpm --filter @vigooth/tui dev",
    "storybook": "pnpm --filter @vigooth/storybook dev",
    "build-storybook": "pnpm --filter @vigooth/storybook build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "packageExtensions": {
      "@inkjs/ui": {
        "dependencies": {
          "react": "18.3.1"
        }
      }
    }
  }
}
